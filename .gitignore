# AI progress store — git-ignored contents except placeholder + README.
# The folder itself is tracked so new clones get the structure; runtime
# learning data (history, best solutions, weights) is never committed.
ai_progress/*
!ai_progress/.gitkeep
!ai_progress/README.md
